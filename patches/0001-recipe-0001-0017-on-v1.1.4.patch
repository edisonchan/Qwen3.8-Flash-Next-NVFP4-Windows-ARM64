+        return sink.put(std.mem.sliceAsBytes(out));
+    }
+
+    fn refuse(name: []const u8, kind: dequant.Kind) error{UnexpectedTensor} {
+        std.log.err("{s}: not a ModelOpt {t} vision linear of the tower's shape", .{ name, kind });
