+        return;
+    }
+    if (t < 256) {
+        unsigned sum = 0u;
+        for (int w = 0; w < 32; ++w) sum += whist[w][t];
+        hist[t] = sum;
+    }
+    __syncthreads();
+    if (t == 0) {
+        const unsigned left = s_left;
+        unsigned above = 0u;
+        int b = 255;
+        for (; b > 0; --b) {
+            if (above + hist[b] >= left) break;
