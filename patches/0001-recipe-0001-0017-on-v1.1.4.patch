diff --git a/zig/tests/cuda/flashnext_cand_tests.zig b/zig/tests/cuda/flashnext_cand_tests.zig
new file mode 100644
index 00000000..c883068d
--- /dev/null
+++ b/zig/tests/cuda/flashnext_cand_tests.zig
@@ -0,0 +1,141 @@
+//! fn_row_cand (the sampled draw's candidates, TF_FLASHNEXT_SAMPLE_CAND=1) against cuda_mtp.zig's topCandidates, which a unit
+//! test holds to a sort of every column: the same set of columns for rows full of ties, both zeros, both infinities, the
+//! draft head's width and the vocabulary's, and a NaN row flagged and left unwritten.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const mtp = flash.mtp;
+const Rig = rig.Rig;
+
+fn tied(r: *Rig, row: []u16, levels: u8) void {
+    if (levels == 0) {
+        // a realistic row: scores around a few units wide, bf16 (the top of the row has few ties)
+        for (row) |*v| {
+            const g = r.rng.floatNorm(f32) * 3.0 - 1.0;
+            v.* = @truncate(@as(u32, @bitCast(g)) >> 16);
+        }
+        return;
+    }
+    const specials = [_]u16{ 0x0000, 0x8000, 0x7f80, 0xff80, 0x3f80, 0xbf80 };
+    for (row) |*v| {
+        const x = r.rng.int(u16);
+        v.* = if (x % 17 == 0) specials[x / 17 % specials.len] else @as(u16, 0x3f00) + r.rng.uintLessThan(u8, levels);
+    }
+}
+
+/// Rows of `n` scores with `count` candidates each (row `bad`, when below `rows`, a NaN row), against the host reference.
+fn rows(r: *Rig, mod: cuda.Module, n: usize, count: usize, levels: u8, bad: usize) !void {
+    const f = try mod.function("fn_row_cand");
+    const rows_n = 5;
+    const stride = mtp.cand_max;
+    const host = try r.a.alloc(u16, rows_n * n);
+    for (0..rows_n) |i| tied(r, host[i * n ..][0..n], levels);
+    if (bad < rows_n) host[bad * n + n / 3] = 0x7fc0;
+    const scores = try r.dev(std.mem.sliceAsBytes(host));
+    const vals = try r.out(rows_n * stride * 4);
+    const cols = try r.out(rows_n * stride * 4);
+    const flags = try r.out(rows_n * 4);
+    var a: cuda.Args = .{};
+    a.add(scores);
+    a.add(@as(c_int, @intCast(n)));
+    a.add(@as(c_longlong, @intCast(n)));
+    a.add(@as(c_int, @intCast(count)));
+    a.add(@as(c_int, @intCast(stride)));
+    a.add(vals);
+    a.add(cols);
+    a.add(flags);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = rows_n }, .block = .{ .x = 1024 } }, r.s, &a);
+    const got_v = try r.back(f32, vals, rows_n * stride);
+    const got_c = try r.back(i32, cols, rows_n * stride);
+    const got_f = try r.back(i32, flags, rows_n);
+    for (0..rows_n) |i| {
+        const row = host[i * n ..][0..n];
+        var want_v: [mtp.cand_max]f32 = undefined;
+        var want_c: [mtp.cand_max]i32 = undefined;
+        const ok = mtp.topCandidates(row, count, &want_v, &want_c);
+        try check.expect(ok == (i != bad) and got_f[i] == @intFromBool(i == bad), "fn_row_cand n={d} count={d} row {d}: NaN flag {d}", .{ n, count, i, got_f[i] });
+        if (!ok) continue;
+        const k = @min(count, n);
+        // the sets (score, column) pairs, sorted by column: the kernel's order is the atomics'
+        const Pair = struct { c: i32, v: f32 };
+        var g: [mtp.cand_max]Pair = undefined;
+        var w: [mtp.cand_max]Pair = undefined;
+        for (0..k) |j| {
+            g[j] = .{ .c = got_c[i * stride + j], .v = got_v[i * stride + j] };
+            w[j] = .{ .c = want_c[j], .v = want_v[j] };
+        }
+        const less = struct {
+            fn before(_: void, x: Pair, y: Pair) bool {
+                return x.c < y.c;
+            }
+        }.before;
+        std.mem.sort(Pair, g[0..k], {}, less);
+        std.mem.sort(Pair, w[0..k], {}, less);
+        for (g[0..k], w[0..k]) |x, y| try check.expect(x.c == y.c and @as(u32, @bitCast(x.v)) == @as(u32, @bitCast(y.v)), "fn_row_cand n={d} count={d} levels={d} row {d}: column {d} (score {e}) for column {d} (score {e})", .{ n, count, levels, i, x.c, x.v, y.c, y.v });
+    }
+}
+
+const Timespec = extern struct { sec: i64, nsec: i64 };
+extern "c" fn clock_gettime(clk: c_int, ts: *Timespec) c_int;
+
+fn nowNs() u64 {
+    var ts: Timespec = undefined;
+    _ = clock_gettime(1, &ts);
+    return @as(u64, @intCast(ts.sec)) * 1_000_000_000 + @as(u64, @intCast(ts.nsec));
+}
+
+/// Microseconds a launch of fn_row_cand takes (back to back on one stream) for `rows_n` rows of `n` scores.
+fn bench(r: *Rig, mod: cuda.Module, n: usize, rows_n: usize, count: usize, levels: u8) !void {
+    const f = try mod.function("fn_row_cand");
+    const host = try r.a.alloc(u16, rows_n * n);
+    for (0..rows_n) |i| tied(r, host[i * n ..][0..n], levels);
+    const scores = try r.dev(std.mem.sliceAsBytes(host));
+    const vals = try r.out(rows_n * mtp.cand_max * 4);
+    const cols = try r.out(rows_n * mtp.cand_max * 4);
+    const flags = try r.out(rows_n * 4);
+    var a: cuda.Args = .{};
+    a.add(scores);
+    a.add(@as(c_int, @intCast(n)));
+    a.add(@as(c_longlong, @intCast(n)));
+    a.add(@as(c_int, @intCast(count)));
+    a.add(@as(c_int, @intCast(mtp.cand_max)));
+    a.add(vals);
+    a.add(cols);
+    a.add(flags);
+    const reps = 500;
+    for (0..20) |_| try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows_n) }, .block = .{ .x = 1024 } }, r.s, &a);
+    try r.s.synchronize();
+    const t0 = nowNs();
+    for (0..reps) |_| try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows_n) }, .block = .{ .x = 1024 } }, r.s, &a);
+    try r.s.synchronize();
+    const us = @as(f64, @floatFromInt(nowNs() - t0)) / 1000.0 / reps;
+    std.debug.print("PERF fn_row_cand n={d} rows={d} count={d} levels={d}: {d:.1} us a launch\n", .{ n, rows_n, count, levels, us });
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(83);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_mtp);
+    defer mod.unload();
+    // the draft head's width (79,591), the vocabulary's (248,320), and short rows; many ties through almost none
+    for ([_]usize{ 70, 1500, 79_591, 248_320 }) |n| for ([_]usize{ 1, 2, 20, 33, 64 }) |count| for ([_]u8{ 0, 1, 3, 40, 200 }) |levels| try rows(&r, mod, n, count, levels, 99);
+    // a NaN row among clean ones: flagged, the others unaffected
+    try rows(&r, mod, 79_591, 20, 0, 2);
+    try rows(&r, mod, 79_591, 20, 40, 2);
+    try rows(&r, mod, 248_320, 20, 0, 4);
+    try rows(&r, mod, 248_320, 20, 40, 4);
+    for ([_]u8{ 0, 3 }) |levels| {
+        try bench(&r, mod, 248_320, 1, 20, levels);
+        try bench(&r, mod, 248_320, 5, 20, levels);
+        try bench(&r, mod, 248_320, 16, 20, levels);
+        try bench(&r, mod, 79_591, 1, 20, levels);
+        try bench(&r, mod, 79_591, 5, 20, levels);
+    }
+    check.pass("flashnext-cand: fn_row_cand's candidates are topCandidates' set for rows of 70 to 248,320 scores, 1 to 64 candidates and ties from every score equal to almost none; a NaN row is flagged", .{});
+}
diff --git a/zig/tests/cuda/flashnext_hc_fuse_tests.zig b/zig/tests/cuda/flashnext_hc_fuse_tests.zig
new file mode 100644
index 00000000..ec17483e
--- /dev/null
+++ b/zig/tests/cuda/flashnext_hc_fuse_tests.zig
@@ -0,0 +1,307 @@
+//! The native read-out's fused kernels (flashnext_hcf.cu, hcn) against the five-launch chain they replace: every output byte,
+//! at several row counts, then the launch times of both chains at a prompt chunk's rows.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const Rig = rig.Rig;
+const tk = flash.tile_kernels;
+
+const dims = 2560;
+const streams = 4;
+const wide = streams * dims;
+const low = 320;
+const n_down = low + streams;
+const nc = dims / 256;
+const eps: f32 = 1e-6;
+
+const Chain = struct {
+    r: *Rig,
+    g: *const flash.Glue,
+    lane: *const cuda.qmmf.Lane,
+    t: *const tk.TileKernels,
+    wdown: cuda.qmmf.Weight,
+    wup: cuda.qmmf.Weight,
+    h: u64,
+    pss: u64,
+    scale: u64,
+    norm: u64,
+    part: u64,
+    act: u64,
+    xs: u64,
+    inj: u64,
+    up: u64,
+    mixed: u64,
+    xsm: u64,
+    spart: u64,
+    rows: usize,
+
+    fn part_poison(c: *Chain) !void {
+        const d = c.r.gpu.d;
+        const bufs = [_][2]u64{ .{ c.part, c.rows * n_down * 4 }, .{ c.mixed, c.rows * dims * 2 }, .{ c.xsm, c.rows * (dims / 32) * 4 } };
+        for (bufs) |b| try (cuda.DeviceBuffer{ .d = d, .ptr = b[0], .len = b[1] }).fill8(0xff, c.r.s.handle);
+    }
+    fn baseNorm(c: *Chain) !void {
+        try c.g.hcNormalize(c.r.s, c.h, c.pss, c.scale, c.norm, eps, c.rows, dims, streams);
+    }
+    fn baseDown(c: *Chain) !void {
+        try c.lane.matmulF32(c.r.s, c.norm, wide, c.rows, c.wdown, c.part, c.spart);
+    }
+    fn reduce(c: *Chain) !void {
+        try c.g.hcReduceAct(c.r.s, c.part, c.act, c.xs, c.inj, 1, c.rows, streams, low, n_down, 1);
+    }
+    fn baseUp(c: *Chain) !void {
+        try c.lane.matmul(c.r.s, c.act, low, c.rows, c.wup, c.up, c.spart);
+    }
+    fn baseMix(c: *Chain) !void {
+        try c.g.hcDenseMix(c.r.s, c.up, c.norm, c.mixed, c.xsm, c.rows, dims, streams);
+    }
+    fn newDown(c: *Chain, vi: usize) !void {
+        const mt = tk.hcn_down_mt[vi];
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.h, c.pss, c.scale, c.wdown.codes, c.part }) |v| a.add(v);
+        for ([_]usize{ c.rows, n_down, wide, cuda.qmmf.splitK(n_down, wide), dims, nc, streams }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const cdiv = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_down[vi], .{ .grid = .{ .x = @intCast(cdiv * 2) }, .block = .{ .x = 224 }, .shared = tk.hcnDownSmem(mt) }, c.r.s, &a);
+    }
+    fn newDown2(c: *Chain, vi: usize) !void {
+        const mt = tk.hcn_dv2_mt[vi];
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.h, c.pss, c.scale, c.wdown.codes, c.part }) |v| a.add(v);
+        for ([_]usize{ c.rows, n_down, wide, cuda.qmmf.splitK(n_down, wide), dims, nc, streams }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const cdiv = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_dv2[vi], .{ .grid = .{ .x = @intCast(cdiv * 2) }, .block = .{ .x = 224 }, .shared = tk.hcnDownSmem(mt) }, c.r.s, &a);
+    }
+    fn upDbg(c: *Chain, vi: usize) !void {
+        const mt = 3;
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.act, c.wup.codes, c.h, c.pss, c.scale, c.mixed, c.xsm }) |v| a.add(v);
+        for ([_]usize{ c.rows, dims, nc }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const cdiv = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_updbg[vi], .{ .grid = .{ .x = @intCast(cdiv * (dims / 32)) }, .block = .{ .x = 256 }, .shared = tk.hcnUpSmem(mt) }, c.r.s, &a);
+    }
+    fn peak(c: *Chain, ctas: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(c.part);
+        a.add(@as(c_int, 4000));
+        try cuda.launch.launch(c.t.hcn_peak, .{ .grid = .{ .x = @intCast(ctas) }, .block = .{ .x = 256 } }, c.r.s, &a);
+    }
+    fn newUp(c: *Chain, vi: usize) !void {
+        const mt = tk.hcn_up_mt[vi];
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.act, c.wup.codes, c.h, c.pss, c.scale, c.mixed, c.xsm }) |v| a.add(v);
+        for ([_]usize{ c.rows, dims, nc }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const cdiv = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_up[vi], .{ .grid = .{ .x = @intCast(cdiv * (dims / 32)) }, .block = .{ .x = 256 }, .shared = tk.hcnUpSmem(mt) }, c.r.s, &a);
+    }
+};
+
+fn timeOf(c: *Chain, start: cuda.Event, end: cuda.Event, comptime f: anytype, arg: anytype) !f64 {
+    const reps = 20;
+    try @call(.auto, f, .{ c, arg });
+    try start.record(c.r.s);
+    for (0..reps) |_| try @call(.auto, f, .{ c, arg });
+    try end.record(c.r.s);
+    try c.r.s.synchronize();
+    return @as(f64, try start.elapsedMs(end)) * 1000 / reps;
+}
+
+fn timeNone(c: *Chain, start: cuda.Event, end: cuda.Event, comptime f: anytype) !f64 {
+    const Wrap = struct {
+        fn call(cc: *Chain, _: void) !void {
+            try f(cc);
+        }
+    };
+    return timeOf(c, start, end, Wrap.call, {});
+}
+
+fn back(r: *Rig, comptime T: type, ptr: u64, n: usize) ![]T {
+    return r.back(T, ptr, n);
+}
+
+/// Mode 3 (the shared expert's output read in place) against mode 2 over a y whose last slot holds a copy of it.
+fn sharedDirect(r: *Rig, g: *const flash.Glue) !void {
+    const slots = 11;
+    for ([_]usize{ 1, 65, 1000 }) |m| {
+        const h = r.bfs(m * wide, 2);
+        const inj = r.bfs(m * streams, 2);
+        const y = r.f32s(m * slots * dims, -1, 1);
+        const shared = r.f32s(m * dims, -1, 1);
+        const wts = r.f32s(m * slots, 0, 0.3);
+        const y2 = try r.a.dupe(f32, y);
+        for (0..m) |row| @memcpy(y2[(row * slots + slots - 1) * dims ..][0..dims], shared[row * dims ..][0..dims]);
+        const dh = try r.dev(std.mem.sliceAsBytes(h));
+        const dinj = try r.dev(std.mem.sliceAsBytes(inj));
+        const dy = try r.dev(std.mem.sliceAsBytes(y));
+        const dy2 = try r.dev(std.mem.sliceAsBytes(y2));
+        const dsh = try r.dev(std.mem.sliceAsBytes(shared));
+        const dw = try r.dev(std.mem.sliceAsBytes(wts));
+        const o2 = try r.out(m * wide * 2);
+        const o3 = try r.out(m * wide * 2);
+        const p2 = try r.out(m * nc * streams * 4);
+        const p3 = try r.out(m * nc * streams * 4);
+        try g.hcWriteback(r.s, dh, o2, p2, 0, dinj, dy2, dw, m * dims, m, dims, streams, 2, 10, 11, 1);
+        try g.hcWriteback(r.s, dh, o3, p3, dsh, dinj, dy, dw, m * dims, m, dims, streams, 3, 10, 11, 1);
+        try check.sameBytes("writeback shared in place: streams", std.mem.sliceAsBytes(try r.back(u16, o3, m * wide)), std.mem.sliceAsBytes(try r.back(u16, o2, m * wide)));
+        try check.sameBytes("writeback shared in place: sums", std.mem.sliceAsBytes(try r.back(f32, p3, m * nc * streams)), std.mem.sliceAsBytes(try r.back(f32, p2, m * nc * streams)));
+        check.pass("hc-fuse: write-back mode 3 (shared expert in place) = mode 2 over a scattered y, {d} rows", .{m});
+    }
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4c2);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var lane = try cuda.qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer lane.unload();
+    var t = try tk.TileKernels.load(gpu.d);
+    defer t.unload();
+
+    try sharedDirect(&r, &g);
+    const most = 3072;
+    // bf16 weights in the lane's order, rows padded to 128 with zeros
+    const wd = r.bfs(n_down * wide, 0.04);
+    const wu = r.bfs(wide * low, 0.4);
+    const pd = try r.a.alloc(u16, cuda.nvfp4.padded(n_down) * wide);
+    cuda.qmmf.packBf16(pd, wd, n_down, wide);
+    const pu = try r.a.alloc(u16, cuda.nvfp4.padded(wide) * low);
+    cuda.qmmf.packBf16(pu, wu, wide, low);
+    const wdown = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pd)), n_down, wide);
+    const wup = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pu)), wide, low);
+    const h = r.bfs(most * wide, 3);
+    const scale = r.f32s(wide, 0.5, 1.5);
+    const dh = try r.dev(std.mem.sliceAsBytes(h));
+    const dscale = try r.dev(std.mem.sliceAsBytes(scale));
+    const dpss = try r.out(most * nc * streams * 4);
+    var c: Chain = .{
+        .r = &r,
+        .g = &g,
+        .lane = &lane,
+        .t = &t,
+        .wdown = wdown,
+        .wup = wup,
+        .h = dh,
+        .pss = dpss,
+        .scale = dscale,
+        .norm = try r.out(most * wide * 2),
+        .part = try r.out(most * n_down * 4),
+        .act = try r.out(most * low * 2),
+        .xs = try r.out(most * (low / 32) * 4),
+        .inj = try r.out(most * streams * 2),
+        .up = try r.out(most * wide * 2),
+        .mixed = try r.out(most * dims * 2),
+        .xsm = try r.out(most * (dims / 32) * 4),
+        .spart = try r.out(8 * most * n_down * 4),
+        .rows = most,
+    };
+    try g.hcWriteback(r.s, dh, 0, dpss, 0, 0, 0, 0, most * dims, most, dims, streams, 0, 1, 1, 1);
+
+    if (std.c.getenv("TF_HCFUSE_PROF") != null) {
+        // one launch of each fused kernel at a full chunk, for ncu
+        c.rows = most;
+        try c.newDown(2);
+        try c.reduce();
+        try c.newUp(1);
+        try c.baseNorm();
+        try c.baseDown();
+        try c.baseUp();
+        try c.baseMix();
+        try r.s.synchronize();
+        return;
+    }
+    const counts = [_]usize{ 64, 65, 193, 255, 256, 1000, 1024, 1536, 2053, 3072 };
+    for (counts) |m| {
+        c.rows = m;
+        // the chain as the engine runs it today
+        try c.baseNorm();
+        try c.baseDown();
+        try c.reduce();
+        try c.baseUp();
+        try c.baseMix();
+        const part0 = try back(&r, f32, c.part, m * n_down);
+        const act0 = try back(&r, u16, c.act, m * low);
+        const xs0 = try back(&r, f32, c.xs, m * (low / 32));
+        const inj0 = try back(&r, u16, c.inj, m * streams);
+        const mixed0 = try back(&r, u16, c.mixed, m * dims);
+        const xsm0 = try back(&r, f32, c.xsm, m * (dims / 32));
+        for (0..tk.hcn_dv2_mt.len - 1) |vi| {
+            try c.part_poison();
+            try c.newDown2(vi);
+            const part2 = try back(&r, f32, c.part, m * n_down);
+            try check.sameBytes("down v2", std.mem.sliceAsBytes(part2), std.mem.sliceAsBytes(part0));
+        }
+        for (0..tk.hcn_down_mt.len) |di| {
+            for (0..tk.hcn_up_mt.len) |ui| {
+                try c.part_poison();
+                try c.newDown(di);
+                const part1 = try back(&r, f32, c.part, m * n_down);
+                try check.sameBytes("down", std.mem.sliceAsBytes(part1), std.mem.sliceAsBytes(part0));
+                try c.reduce();
+                try c.newUp(ui);
+                const act1 = try back(&r, u16, c.act, m * low);
+                const xs1 = try back(&r, f32, c.xs, m * (low / 32));
+                const inj1 = try back(&r, u16, c.inj, m * streams);
+                const mixed1 = try back(&r, u16, c.mixed, m * dims);
+                const xsm1 = try back(&r, f32, c.xsm, m * (dims / 32));
+                try check.sameBytes("act", std.mem.sliceAsBytes(act1), std.mem.sliceAsBytes(act0));
+                try check.sameBytes("act sums", std.mem.sliceAsBytes(xs1), std.mem.sliceAsBytes(xs0));
+                try check.sameBytes("inject", std.mem.sliceAsBytes(inj1), std.mem.sliceAsBytes(inj0));
+                try check.sameBytes("mixed", std.mem.sliceAsBytes(mixed1), std.mem.sliceAsBytes(mixed0));
+                try check.sameBytes("mixed sums", std.mem.sliceAsBytes(xsm1), std.mem.sliceAsBytes(xsm0));
+            }
+        }
+        check.pass("hc-fuse: {d} rows: down tiles {d}, up tiles {d}: every output byte equals the five-launch chain's", .{ m, tk.hcn_down_mt.len, tk.hcn_up_mt.len });
+    }
+
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    for ([_]usize{ 3072, 2560, 2048, 1536, 1024, 768, 512, 256 }) |m| {
+        c.rows = m;
+        const flop = 2.0 * @as(f64, @floatFromInt(m)) * wide * n_down;
+        const nm = try timeNone(&c, start, end, Chain.baseNorm);
+        const bd = try timeNone(&c, start, end, Chain.baseDown);
+        const ra = try timeNone(&c, start, end, Chain.reduce);
+        const bu = try timeNone(&c, start, end, Chain.baseUp);
+        const bm = try timeNone(&c, start, end, Chain.baseMix);
+        std.debug.print("RESULT hc-fuse rows {d}: base normalize {d:.1} us, down {d:.1} us ({d:.1} TF), reduce_act {d:.1} us, up {d:.1} us ({d:.1} TF), mix {d:.1} us; chain {d:.1} us\n", .{ m, nm, bd, flop / bd / 1e6, ra, bu, flop / bu / 1e6, bm, nm + bd + ra + bu + bm });
+        var best_d: f64 = 1e18;
+        var best_u: f64 = 1e18;
+        for (0..tk.hcn_down_mt.len) |di| {
+            const us = try timeOf(&c, start, end, Chain.newDown, di);
+            best_d = @min(best_d, us);
+            std.debug.print("RESULT hc-fuse rows {d}: new down mt={d}: {d:.1} us ({d:.1} TF)\n", .{ m, tk.hcn_down_mt[di], us, flop / us / 1e6 });
+        }
+        for (0..tk.hcn_dv2_mt.len) |vi| {
+            const us = try timeOf(&c, start, end, Chain.newDown2, vi);
+            std.debug.print("RESULT hc-fuse rows {d}: down v2 {s}: {d:.1} us ({d:.1} TF)\n", .{ m, tk.hcn_dv2_names[vi], us, flop / us / 1e6 });
+        }
+        for (0..tk.hcn_up_mt.len) |ui| {
+            const us = try timeOf(&c, start, end, Chain.newUp, ui);
+            best_u = @min(best_u, us);
+            std.debug.print("RESULT hc-fuse rows {d}: new up+mix mt={d}: {d:.1} us ({d:.1} TF)\n", .{ m, tk.hcn_up_mt[ui], us, flop / us / 1e6 });
+        }
+        if (m == 3072) for (0..tk.hcn_updbg_names.len) |vi| {
+            const us = try timeOf(&c, start, end, Chain.upDbg, vi);
+            std.debug.print("RESULT hc-fuse rows {d}: up+mix mt=3 debug {s}: {d:.1} us\n", .{ m, tk.hcn_updbg_names[vi], us });
+        };
+        std.debug.print("RESULT hc-fuse rows {d}: chain base {d:.1} us, new best {d:.1} us\n", .{ m, nm + bd + ra + bu + bm, best_d + ra + best_u });
+    }
+    for ([_]usize{ 48, 96, 144 }) |ctas| {
+        const us = try timeOf(&c, start, end, Chain.peak, ctas);
+        const flops = @as(f64, @floatFromInt(ctas)) * 8 * 4000 * 12 * 4096;
+        std.debug.print("RESULT hc-fuse mma ceiling: {d} CTAs x 8 warps: {d:.1} us = {d:.1} TF\n", .{ ctas, us, flops / us / 1e6 });
+    }
+    r.report("hc-fuse");
+}
diff --git a/zig/tests/cuda/flashnext_keep_late_tests.zig b/zig/tests/cuda/flashnext_keep_late_tests.zig
new file mode 100644
index 00000000..13dff5cd
--- /dev/null
+++ b/zig/tests/cuda/flashnext_keep_late_tests.zig
@@ -0,0 +1,170 @@
+//! TF_FLASHNEXT_KEEP_LATE: a window kept in part leaves its rows in the draft's log for the next window's chain instead of replaying
+//! them, and everything the engine sees afterwards (scores, hidden rows, conv windows, n-gram tails, the DeltaNet states once
+//! they are taken) is byte for byte what the replaying rollback leaves.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const prompt = flash.prompt;
+const mtp = flash.mtp;
+
+const lanes_n = 3;
+/// Rounds a script runs: lane 0's 25 pairs of consecutive keeps twice over, then 20 rounds keeping one row (the log overflows).
+const pairs_rounds = 50;
+const rounds = pairs_rounds + 20;
+
+const Side = struct {
+    seqs: [lanes_n]prompt.Seq = undefined,
+    drafts: [lanes_n]mtp.Draft = undefined,
+    made: usize = 0,
+
+    fn deinit(s: *Side, gpa: std.mem.Allocator) void {
+        for (s.seqs[0..s.made], s.drafts[0..s.made]) |*q, *d| {
+            d.deinit();
+            q.deinit(gpa);
+        }
+    }
+};
+
+pub fn run(gpu: check.Gpu, dir: []const u8, ids_path: []const u8) !void {
+    const source = try std.Io.Dir.cwd().readFileAlloc(gpu.io, ids_path, gpu.gpa, .limited(1 << 20));
+    defer gpu.gpa.free(source);
+    var base: std.ArrayList(u32) = .empty;
+    defer base.deinit(gpu.gpa);
+    var words = std.mem.tokenizeAny(u8, source, " \r\n\t");
+    while (words.next()) |word| try base.append(gpu.gpa, try std.fmt.parseInt(u32, word, 10));
+    if (base.items.len < 16) return error.BadPrompt;
+    var stream = try cuda.Stream.init(gpu.d, true);
+    defer stream.deinit();
+    var glue = try flash.Glue.load(gpu.d);
+    defer glue.deinit();
+    const tri: flash.Tri = .{ .s = stream, .own = &glue };
+    const e = try prompt.Engine.init(gpu.gpa, gpu.io, @constCast(gpu.d), &stream, dir);
+    defer e.deinit();
+    const ops: mtp.Ops(flash.Tri) = .{ .e = e, .tri = tri, .h = undefined };
+    var shared = try cuda.DeviceBuffer.alloc(gpu.d, 64 * prompt.vocabulary * 2);
+    defer shared.free();
+    for ([_]usize{ @min(base.items.len, 100), 2600 }) |length| {
+        const ids = try gpu.gpa.alloc(u32, length);
+        defer gpu.gpa.free(ids);
+        for (ids, 0..) |*t, i| t.* = base.items[i % base.items.len];
+        for ([_]bool{ true, false }) |together| try script(gpu, e, ops, &stream, shared.ptr, ids, together);
+    }
+}
+
+/// Lane `i`'s window in round `r`: its width and kept rows. Lane 0 is 5 rows with every pair of keeps in turn, lane 1 varies in
+/// width (1-row windows take the waiting rows in place), lane 2 is 16 rows wide (the log's whole capacity with 16 waiting).
+fn plan(i: usize, r: usize) struct { width: usize, keep: usize } {
+    switch (i) {
+        0 => {
+            const keep = if (r < pairs_rounds) 1 + (if (r % 2 == 0) (r / 2 / 5) % 5 else (r / 2) % 5) else 1;
+            return .{ .width = 5, .keep = keep };
+        },
+        1 => {
+            const width = 1 + (r * 5 + 3) % 8;
+            return .{ .width = width, .keep = 1 + (r * 7 + 2) % width };
+        },
+        else => return .{ .width = 16, .keep = 1 + (r * 3 + 1) % 16 },
+    }
+}
+
+fn script(gpu: check.Gpu, e: *prompt.Engine, ops: mtp.Ops(flash.Tri), stream: *cuda.Stream, shared: u64, ids: []const u32, together: bool) !void {
+    const gpa = gpu.gpa;
+    const row_bytes = prompt.vocabulary * 2;
+    const cap = ids.len + rounds * 16 + 64;
+    var replay: Side = .{};
+    defer replay.deinit(gpa);
+    var late: Side = .{};
+    defer late.deinit(gpa);
+    inline for (.{ .{ &replay, false }, .{ &late, true } }) |pair| {
+        const side = pair[0];
+        mtp.Draft.late_force = pair[1];
+        defer mtp.Draft.late_force = null;
+        for (0..lanes_n) |i| {
+            const prompt_len = ids.len - 3 * i;
+            side.seqs[i] = try e.newSeq(cap);
+            side.drafts[i] = mtp.Draft.init(gpa, e.driver, stream.*, cap, 1, e.chunk) catch |err| {
+                side.seqs[i].deinit(gpa);
+                return err;
+            };
+            side.made += 1;
+            try e.forward(flash.Tri, ops.tri, &side.seqs[i], ids[0..prompt_len], .{});
+        }
+    }
+    try check.expect(late.drafts[0].log != null and replay.drafts[0].log == null, "the late side has its log, the replaying one none", .{});
+    const hidden = replay.drafts[0].streams.len / replay.drafts[0].rows_cap;
+    const want = try gpa.alloc(u8, 16 * @max(row_bytes, hidden));
+    defer gpa.free(want);
+    const got = try gpa.alloc(u8, 16 * @max(row_bytes, hidden));
+    defer gpa.free(got);
+    var window: [lanes_n][16]u32 = undefined;
+    var compared: usize = 0;
+    var waited: usize = 0;
+    for (0..rounds) |r| {
+        var seqs: [lanes_n]*prompt.Seq = undefined;
+        var ds: [lanes_n]*mtp.Draft = undefined;
+        var idss: [lanes_n][]const u32 = undefined;
+        for (0..lanes_n) |i| {
+            const w = plan(i, r).width;
+            for (window[i][0..w], 0..) |*t, k| t.* = @intCast((37 + 101 * i + 17 * k + 29 * r) % 50_000);
+            try ops.verify(&replay.seqs[i], &replay.drafts[i], window[i][0..w]);
+            seqs[i] = &late.seqs[i];
+            ds[i] = &late.drafts[i];
+            idss[i] = window[i][0..w];
+            if (!together) try ops.verify(seqs[i], ds[i], idss[i]);
+        }
+        if (together) try ops.verifyMany(&seqs, &ds, &idss, shared);
+        try stream.synchronize();
+        for (0..lanes_n) |i| {
+            const w = plan(i, r).width;
+            inline for (.{ .{ "scores", row_bytes, "logits" }, .{ "hidden rows", hidden, "streams" } }) |f| {
+                try e.driver.check(e.driver.api.cuMemcpyDtoH_v2(want.ptr, @field(replay.drafts[i], f[2]).ptr, w * f[1]), "cuMemcpyDtoH");
+                try e.driver.check(e.driver.api.cuMemcpyDtoH_v2(got.ptr, @field(late.drafts[i], f[2]).ptr, w * f[1]), "cuMemcpyDtoH");
+                try check.sameBytes("a window after waiting rows has the replaying side's " ++ f[0], got[0 .. w * f[1]], want[0 .. w * f[1]]);
+            }
+            compared += 1;
+            const keep = plan(i, r).keep;
+            try ops.rollback(&replay.seqs[i], &replay.drafts[i], keep);
+            try ops.rollback(&late.seqs[i], &late.drafts[i], keep);
+            try stream.synchronize();
+            try check.expect(replay.seqs[i].fed == late.seqs[i].fed, "kept positions match", .{});
+            try check.expect(std.mem.eql(i64, &replay.seqs[i].history, &late.seqs[i].history), "kept n-gram histories match", .{});
+            try sameConv(gpu, replay.seqs[i], late.seqs[i]);
+            try sameBuf(gpu, "the n-gram tail after a rollback", replay.seqs[i].tail, late.seqs[i].tail);
+            waited += late.drafts[i].pend;
+            // the states: equal whenever none wait; a lane's waiting rows are taken now every seventh round and its states compared
+            if (late.drafts[i].pend > 0 and r % 7 == 6 and r < pairs_rounds) {
+                try ops.flushLate(&late.seqs[i], &late.drafts[i]);
+                try stream.synchronize();
+            }
+            if (late.drafts[i].pend == 0) try sameStates(gpu, replay.seqs[i], late.seqs[i]);
+        }
+    }
+    // every lane's waiting rows taken, then one plain row on each
+    for (0..lanes_n) |i| {
+        try ops.flushLate(&late.seqs[i], &late.drafts[i]);
+        try stream.synchronize();
+        try sameStates(gpu, replay.seqs[i], late.seqs[i]);
+        try e.forward(flash.Tri, ops.tri, &replay.seqs[i], &.{13}, .{});
+        try e.forward(flash.Tri, ops.tri, &late.seqs[i], &.{13}, .{});
+        try stream.synchronize();
+        try check.sameBytes("the row after the last rollback", late.seqs[i].logits, replay.seqs[i].logits);
+    }
+    check.pass("keep late, {s}, {d} lanes x {d} rounds at {d} prompt tokens: {d} windows' scores and hidden rows, conv windows, tails and states byte-exact ({d} waiting rows seen)", .{ if (together) "shared passes" else "lone passes", lanes_n, rounds, ids.len, compared, waited });
+}
+
+fn sameBuf(gpu: check.Gpu, what: []const u8, want: cuda.DeviceBuffer, got: cuda.DeviceBuffer) !void {
+    const xs = try check.download(gpu, want);
+    defer gpu.gpa.free(xs);
+    const ys = try check.download(gpu, got);
+    defer gpu.gpa.free(ys);
+    try check.sameBytes(what, ys, xs);
+}
+
+fn sameConv(gpu: check.Gpu, a: prompt.Seq, b: prompt.Seq) !void {
+    for (a.conv, b.conv) |x, y| try sameBuf(gpu, "a conv window after a rollback", x, y);
+}
+
+fn sameStates(gpu: check.Gpu, a: prompt.Seq, b: prompt.Seq) !void {
+    for (a.state, b.state) |x, y| try sameBuf(gpu, "a DeltaNet state after a rollback", x, y);
+}
diff --git a/zig/tests/cuda/flashnext_kv8_tests.zig b/zig/tests/cuda/flashnext_kv8_tests.zig
new file mode 100644
index 00000000..e0615aba
--- /dev/null
+++ b/zig/tests/cuda/flashnext_kv8_tests.zig
@@ -0,0 +1,194 @@
+//! --kv-cache fp8 on the device: the quantizing write (fn_attn_prep_kv8) against cuda_kv.zig's model of the format, and the
+//! widening reads (fn_attn_chunks_kv8, fn_attn_fused_kv8) against the bf16 kernels run on the dequantized rows, byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const kvf = flash.kv_format;
+const Rig = rig.Rig;
+const bf = rig.bf;
+
+const q_heads = 24;
+const kv_heads = 2;
+const head_dim = 256;
+const index_heads = 4;
+const index_dim = 128;
+const half = 32;
+const proj_n = 13952;
+const eps: f32 = 1e-6;
+const cap = 3072;
+const idw = 2052;
+const key_stride = kvf.key_stride;
+
+fn inverse(r: *Rig) ![]f32 {
+    const inv = try r.a.alloc(f32, half);
+    for (inv, 0..) |*o, i| o.* = @floatCast(std.math.pow(f64, 10_000_000.0, -@as(f64, @floatFromInt(i)) / half));
+    return inv;
+}
+
+fn f32of(h: u16) f32 {
+    return @floatCast(bf(h));
+}
+
+/// The write: the bf16 kernel's key and value rows through the model must be the fp8 kernel's bytes, and everything else it writes
+/// (queries, indexer queries and keys) the bf16 kernel's bytes.
+fn prep(r: *Rig, g: *const flash.Glue) !void {
+    const rows = 17;
+    const pos0 = 700;
+    const p = r.bfs(rows * proj_n, 2);
+    // row 1's values are all zero (a zero row: scale 2^-126, zero codes)
+    const v_at = q_heads * 2 * head_dim + kv_heads * head_dim;
+    @memset(p[proj_n + v_at ..][0 .. kv_heads * head_dim], 0);
+    const qw = r.f32s(head_dim, 0.5, 1.5);
+    const kw = r.f32s(head_dim, 0.5, 1.5);
+    const iw = r.f32s(index_dim, 0.5, 1.5);
+    const inv = try inverse(r);
+    const dp = try r.dev(std.mem.sliceAsBytes(p));
+    const dpos = try r.dev(std.mem.sliceAsBytes(&[_]i32{ pos0, 0, 0, 0 }));
+    const dqw = try r.dev(std.mem.sliceAsBytes(qw));
+    const dkw = try r.dev(std.mem.sliceAsBytes(kw));
+    const diw = try r.dev(std.mem.sliceAsBytes(iw));
+    const dinv = try r.dev(std.mem.sliceAsBytes(inv));
+    // bf16 caches, then fp8 ones
+    const q_b = try r.out(rows * q_heads * head_dim * 2);
+    const iq_b = try r.out(rows * index_heads * index_dim * 2);
+    const kc_b = try r.out(cap * kv_heads * head_dim * 2);
+    const vc_b = try r.out(cap * kv_heads * head_dim * 2);
+    const ikc_b = try r.out(cap * index_dim * 2);
+    try g.attnPrep(r.s, dp, dpos, dqw, dkw, diw, dinv, q_b, kc_b, vc_b, iq_b, ikc_b, eps, rows);
+    const q_8 = try r.out(rows * q_heads * head_dim * 2);
+    const iq_8 = try r.out(rows * index_heads * index_dim * 2);
+    const kc_8 = try r.out(cap * kvf.Kv.fp8.keyRow());
+    const vc_8 = try r.out(cap * kvf.Kv.fp8.valueRow());
+    const ikc_8 = try r.out(cap * index_dim * 2);
+    try g.attnPrepKv8(r.s, dp, dpos, dqw, dkw, diw, dinv, q_8, kc_8, vc_8, iq_8, ikc_8, eps, rows);
+
+    try r.sameRows("fp8 prep queries", u16, q_8, try r.back(u16, q_b, rows * q_heads * head_dim));
+    try r.sameRows("fp8 prep indexer queries", u16, iq_8, try r.back(u16, iq_b, rows * index_heads * index_dim));
+    try r.sameRows("fp8 prep indexer keys", u16, ikc_8 + pos0 * index_dim * 2, (try r.back(u16, ikc_b, cap * index_dim))[pos0 * index_dim ..][0 .. rows * index_dim]);
+
+    const kb = try r.back(u16, kc_b, cap * kv_heads * head_dim);
+    const vb = try r.back(u16, vc_b, cap * kv_heads * head_dim);
+    const k8 = try r.back(u8, kc_8, cap * kvf.Kv.fp8.keyRow());
+    const v8 = try r.back(u8, vc_8, cap * kvf.Kv.fp8.valueRow());
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    var want_k: [key_stride]u8 = undefined;
+    var want_v: [head_dim]u8 = undefined;
+    for (0..rows) |row| for (0..kv_heads) |h| {
+        const slot = kvf.slotOf(pos0 + row, h);
+        for (&k, &v, 0..) |*a, *b, d| {
+            a.* = f32of(kb[slot * head_dim + d]);
+            b.* = f32of(vb[slot * head_dim + d]);
+        }
+        kvf.packRows(&k, &v, &want_k, &want_v);
+        try check.sameBytes("fp8 prep key row (codes, scales, zero tail)", k8[kvf.keyRowAt(slot)..][0..key_stride], &want_k);
+        try check.sameBytes("fp8 prep value row", v8[kvf.valueRowAt(slot)..][0..head_dim], &want_v);
+    };
+    // positions the launch did not write stay as filled
+    try check.expect(k8[kvf.keyRowAt(kvf.slotOf(pos0 - 1, 1))] == 0xff and v8[kvf.valueRowAt(kvf.slotOf(pos0 + rows, 0))] == 0xff, "fp8 prep writes only its rows' positions", .{});
+    // the zero value row of row 1: zero codes and the smallest scale
+    const zero_slot = kvf.slotOf(pos0 + 1, 0);
+    for (v8[kvf.valueRowAt(zero_slot)..][0..head_dim]) |c| try check.expect(c == 0, "a zero value row has zero codes", .{});
+    const sv: f32 = @bitCast(std.mem.readInt(u32, k8[kvf.keyRowAt(zero_slot) + kvf.value_scale_at ..][0..4], .little));
+    try check.expect(sv == 0x1p-126, "a zero value row's scale is 2^-126", .{});
+}
+
+/// A cache's rows of bf16 values, each row of a different size, as the format's bytes (kc8, vc8) and the bf16 rows they dequantize to.
+const Cache = struct {
+    kc8: []u8,
+    vc8: []u8,
+    kcd: []u16,
+    vcd: []u16,
+};
+
+fn cache(r: *Rig) !Cache {
+    const slots = cap * kv_heads;
+    const c: Cache = .{
+        .kc8 = try r.a.alloc(u8, slots * key_stride),
+        .vc8 = try r.a.alloc(u8, slots * head_dim),
+        .kcd = try r.a.alloc(u16, slots * head_dim),
+        .vcd = try r.a.alloc(u16, slots * head_dim),
+    };
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    var back: [head_dim]f32 = undefined;
+    for (0..slots) |slot| {
+        const size = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(slot * 7 % 9)) - 4);
+        for (&k, &v) |*a, *b| {
+            a.* = @floatCast(bf(rig.bf16(@floatCast((r.rng.float(f32) * 2 - 1) * size))));
+            b.* = @floatCast(bf(rig.bf16(@floatCast((r.rng.float(f32) * 2 - 1) * size * 0.5))));
+        }
+        const kr = c.kc8[slot * key_stride ..][0..key_stride];
+        const vr = c.vc8[slot * head_dim ..][0..head_dim];
+        kvf.packRows(&k, &v, kr, vr);
+        kvf.dequantizeRow(kr[0..head_dim], @bitCast(std.mem.readInt(u32, kr[kvf.key_scale_at..][0..4], .little)), &back);
+        for (back, c.kcd[slot * head_dim ..][0..head_dim]) |a, *o| o.* = rig.bf16(a);
+        kvf.dequantizeRow(vr, @bitCast(std.mem.readInt(u32, kr[kvf.value_scale_at..][0..4], .little)), &back);
+        for (back, c.vcd[slot * head_dim ..][0..head_dim]) |a, *o| o.* = rig.bf16(a);
+    }
+    return c;
+}
+
+/// The read: the fp8 kernels over the codes against the bf16 kernels over the dequantized rows, dense and sparse, 1, 3 and 20 rows
+/// (the bf16 side reads ahead for up to 16 rows, one tile at a time past that), and the fused prompt launch.
+fn attention(r: *Rig, g: *const flash.Glue, c: Cache, sparse: bool) !void {
+    const counts = [_]usize{ 1, 3, 20 };
+    const rows = counts[counts.len - 1];
+    const pos0: usize = if (sparse) 2600 else 1100;
+    const q = r.bfs(rows * q_heads * head_dim, 1);
+    const ids = try r.a.alloc(i32, rows * idw);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    for (0..rows) |row| {
+        nk[row] = @intCast(if (sparse) idw - 1 - row % 3 else pos0 + row + 1);
+        spr[row] = @intFromBool(sparse);
+        for (0..idw) |i| ids[row * idw + i] = @intCast((i * 1237 + row * 31) % (pos0 + row + 1));
+    }
+    const dq = try r.dev(std.mem.sliceAsBytes(q));
+    const dkc8 = try r.dev(c.kc8);
+    const dvc8 = try r.dev(c.vc8);
+    const dkcd = try r.dev(std.mem.sliceAsBytes(c.kcd));
+    const dvcd = try r.dev(std.mem.sliceAsBytes(c.vcd));
+    const dpos = try r.dev(std.mem.sliceAsBytes(&[_]i32{ @intCast(pos0), 0, 0, 0 }));
+    const dids = try r.dev(std.mem.sliceAsBytes(ids));
+    const dnk = try r.dev(std.mem.sliceAsBytes(nk));
+    const dspr = try r.dev(std.mem.sliceAsBytes(spr));
+    const nch = 5;
+    const po = try r.out(rows * nch * q_heads * head_dim * 4);
+    const pm = try r.out(rows * nch * q_heads * 4);
+    const pl = try r.out(rows * nch * q_heads * 4);
+    const name = if (sparse) "fp8 attention sparse" else "fp8 attention dense";
+    for (counts) |m| {
+        const chunks = if (sparse) (idw + 511) / 512 else (pos0 + m + 511) / 512;
+        const want = try r.out(m * q_heads * head_dim * 2);
+        try g.attnChunks(r.s, dq, dkcd, dvcd, dpos, po, pm, pl, dids, dnk, dspr, m, kv_heads, chunks, true);
+        try g.attnMerge(r.s, po, pm, pl, dpos, want, dnk, dspr, m, kv_heads, true);
+        const got = try r.out(m * q_heads * head_dim * 2);
+        try g.attnChunksKv8(r.s, dq, dkc8, dvc8, dpos, po, pm, pl, dids, dnk, dspr, m, kv_heads, chunks, true);
+        try g.attnMerge(r.s, po, pm, pl, dpos, got, dnk, dspr, m, kv_heads, true);
+        try r.sameRows(name, u16, got, try r.back(u16, want, m * q_heads * head_dim));
+    }
+    const want = try r.out(rows * q_heads * head_dim * 2);
