+
+/// Takes the next expert until the group is exhausted; the first failure stops the others.
+fn work(j: *Job, errs: []?anyerror, slot: usize) void {
+    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
+    defer arena.deinit();
+    while (!j.stop.load(.monotonic)) {
+        const i = j.next.fetchAdd(1, .monotonic);
+        if (i >= j.count) return;
+        j.pack(i, arena.allocator()) catch |e| {
+            errs[slot] = e;
+            j.stop.store(true, .monotonic);
+            return;
+        };
+        _ = arena.reset(.retain_capacity);
+    }
+}
+
+fn packGroup(j: *Job, threads: usize) !void {
+    const n = @max(1, @min(threads, j.count));
+    var errs: [max_threads]?anyerror = @splat(null);
+    var spawned: [max_threads]std.Thread = undefined;
+    var started: usize = 0;
+    for (1..n) |t| {
+        spawned[started] = std.Thread.spawn(.{}, work, .{ j, errs[0..n], t }) catch break;
+        started += 1;
+    }
+    work(j, errs[0..n], 0);
+    for (spawned[0..started]) |th| th.join();
+    for (errs[0..n]) |e| if (e) |err| return err;
+}
