+            .prefix = prefix,
+            .cut = cut,
+            .dims = dims,
+            .full_width = full_width,
+            .first = first,
+            .count = n,
+            .up_bytes = up_bytes,
+            .down_bytes = down_bytes,
+            .up_stage = st.up.bytes,
+            .down_stage = st.down.bytes,
+            .up_globals = up_globals[first * 2 ..][0 .. n * 2],
+            .down_globals = down_globals[first..][0..n],
+        };
