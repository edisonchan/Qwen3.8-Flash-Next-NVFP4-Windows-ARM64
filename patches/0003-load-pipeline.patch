+/// Host threads packing one group of experts while the copy engine lands the group before it.
+const max_threads: usize = 32;
+/// Experts in one stage: the unit read, packed and copied as a batch.
+const stage_default: usize = 16;
+
+const Stage = struct {
+    up: cuda.HostBuffer,
+    down: cuda.HostBuffer,
+    done: cuda.Event,
+    pending: bool = false,
+
+    fn init(d: *const cuda.Driver, experts: usize, up_bytes: usize, down_bytes: usize) !Stage {
+        var up = try cuda.HostBuffer.alloc(d, experts * up_bytes);
+        errdefer up.free();
+        var down = try cuda.HostBuffer.alloc(d, experts * down_bytes);
+        errdefer down.free();
+        var done = try cuda.Event.init(d, false);
+        errdefer done.deinit();
+        return .{ .up = up, .down = down, .done = done };
+    }
+
+    /// A stage is rewritten only once its previous copies have landed.
+    fn reuse(self: *Stage) !void {
+        if (!self.pending) return;
+        try self.done.synchronize();
+        self.pending = false;
+    }
+
+    fn free(self: *Stage) void {
+        self.up.free();
+        self.down.free();
+        self.done.deinit();
+    }
+};
+
+const Job = struct {
+    store: *wt.Store,
+    prefix: []const u8,
+    cut: Cut,
+    dims: usize,
+    full_width: usize,
+    /// The first expert of this group and how many the group holds.
+    first: usize,
+    count: usize,
+    up_bytes: usize,
+    down_bytes: usize,
+    up_stage: []u8,
+    down_stage: []u8,
+    up_globals: []f32,
+    down_globals: []f32,
+    next: std.atomic.Value(usize) = .init(0),
+    stop: std.atomic.Value(bool) = .init(false),
+
+    /// One expert's three projections read, packed into the stage's slot and its globals recorded.
+    fn pack(self: *Job, i: usize, a: std.mem.Allocator) !void {
+        try packExpert(a, self.store, self.prefix, self.first + i, self.cut, self.dims, self.full_width, self.up_stage[i * self.up_bytes ..][0..self.up_bytes], self.down_stage[i * self.down_bytes ..][0..self.down_bytes], self.up_globals[i * 2 ..][0..2], self.down_globals[i..][0..1]);
+    }
+};
+
+/// One expert's gate, up and down read and packed into the caller's slots, its three global scales recorded.
+fn packExpert(a: std.mem.Allocator, store: anytype, prefix: []const u8, e: usize, cut: Cut, dims: usize, full_width: usize, up_slot: []u8, down_slot: []u8, up_globals: []f32, down_globals: []f32) !void {
+    var buf: [512]u8 = undefined;
+    var gate = try readPart(a, store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.gate_proj", .{ prefix, e }), cut, false, dims, full_width);
+    defer gate.deinit(a);
+    var value = try readPart(a, store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.up_proj", .{ prefix, e }), cut, false, dims, full_width);
+    defer value.deinit(a);
+    var output = try readPart(a, store, try std.fmt.bufPrint(&buf, "{s}.experts.{d}.down_proj", .{ prefix, e }), cut, true, dims, full_width);
+    defer output.deinit(a);
+    const width = cut.width();
+    // the slots are pinned or allocator memory, so their words are 4-byte aligned where they land
+    const up_words: []align(4) u8 = @alignCast(up_slot);
+    const down_words: []align(4) u8 = @alignCast(down_slot);
+    ex.packGateUp(std.mem.bytesAsSlice(u32, up_words), .{ gate.codes, gate.scales }, .{ value.codes, value.scales }, width, dims);
+    ex.packOne(std.mem.bytesAsSlice(u32, down_words), output.codes, output.scales, dims, width);
+    up_globals[0] = gate.global;
+    up_globals[1] = value.global;
+    down_globals[0] = output.global;
