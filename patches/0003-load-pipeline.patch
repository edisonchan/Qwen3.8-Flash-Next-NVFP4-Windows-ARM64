+    const group = @min(@max(envNumber("TENSORFOLD_LOAD_GROUP") orelse stage_default, 1), count);
+    var copy = try cuda.Stream.init(d, true);
+    defer copy.deinit();
+    var stages = [2]Stage{ try Stage.init(d, group, up_bytes, down_bytes), undefined };
+    errdefer stages[0].free();
+    stages[1] = try Stage.init(d, group, up_bytes, down_bytes);
+    defer for (&stages) |*s| s.free();
+    const stats = loadStatsOn();
+    var packed_ns: u64 = 0;
+    var waited_ns: u64 = 0;
+    var first: usize = 0;
+    var g: usize = 0;
+    while (first < count) : (g += 1) {
+        const n = @min(group, count - first);
+        const st = &stages[g % 2];
+        const w0 = if (stats) now(store.io) else 0;
+        try st.reuse();
