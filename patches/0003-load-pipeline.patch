+fn fill(d: *const cuda.Driver, store: *wt.Store, prefix: []const u8, cut: Cut, dims: usize, full_width: usize, count: usize, up_bytes: usize, down_bytes: usize, up: cuda.DeviceBuffer, down: cuda.DeviceBuffer, up_globals: []f32, down_globals: []f32) !void {
